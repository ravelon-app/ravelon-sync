# Ravelon Sync configuration.
#
# Copy to .env and fill in. Everything below the "Required" block has a
# working default; a minimal deployment sets four values and nothing else.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Three independent random values, at least 32 bytes each. Generate them with:
#   ./scripts/generate-secrets.sh
#
# SYNC_JWT_SECRET signs access tokens. Changing it signs everyone out.
# MFA_ENCRYPTION_KEY encrypts authenticator secrets and keys recovery-code
# hashes. Losing it means every account has to re-enrol its second factor.
# SETTINGS_ENCRYPTION_KEY encrypts the SMTP password stored in the database.
#
# Back all three up with your database. They are not recoverable.
SYNC_JWT_SECRET=
MFA_ENCRYPTION_KEY=
SETTINGS_ENCRYPTION_KEY=

# The public origin people reach this server at, with no trailing path.
# Invitation, pairing and password-reset links are built from it.
PUBLIC_URL=https://sync.example.com

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

PORT=4100
HOST=0.0.0.0

# Exact IPs or CIDRs of your reverse proxy, comma separated. Only these are
# trusted to report the real client address. Leave empty when nothing proxies
# this server: trusting every hop would let any client forge its own IP and
# walk straight past the per-IP rate limits.
TRUSTED_PROXY_IPS=

# Extra browser origins allowed to call the API. The bundled web interface is
# same-origin and needs no entry here. Leave empty unless you serve the
# interface from somewhere else.
CORS_ORIGINS=

# Directory the built web interface is served from. Set to an empty string for
# an API-only deployment.
# WEB_ROOT=public

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLite by default. Fine for a single instance and a small team; back up this
# file (and its -wal companion) with the server stopped, or use the backup
# script in scripts/.
DATABASE_FILE=./data/ravelon-sync.db

# PostgreSQL takes precedence when set. Use it for replicas, or when you would
# rather back this up with the rest of your databases.
# DATABASE_URL=postgresql://ravelon:password@127.0.0.1:5432/ravelon_sync

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------

# Without SMTP the server works fully; invitations and password resets become
# links you copy out of the admin interface and send yourself.
# These are fallbacks: settings saved in the admin interface take precedence.
SMTP_HOST=
SMTP_PORT=587
# starttls (587), tls (465), or none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Ravelon Sync <sync@example.com>

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------

# Encrypted storage one vault may hold, in megabytes.
VAULT_STORAGE_LIMIT_MB=256

# Vaults one account may own.
VAULTS_PER_USER=50

# Sessions. An access token is short-lived; the refresh token is what keeps a
# device signed in, and it rotates on every use.
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=60

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Leave enabled. Turning it off removes the brute-force protection on sign-in.
# RATE_LIMIT_DISABLED=false
RATE_LIMIT_AUTH_PER_IP=30
RATE_LIMIT_AUTH_FAILURES=10
RATE_LIMIT_SYNC_PER_USER=240
RATE_LIMIT_API_PER_USER=600
