{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "*.json",
      "biome.jsonc",
      "server/*.json",
      "server/src/**",
      "server/test/**",
      "web/*.json",
      "web/*.ts",
      "web/src/**",
      "!**/package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // Stylistic: each use re-reads a row written or checked just before.
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": { "enabled": false },
  "overrides": [
    {
      "includes": ["web/**"],
      "javascript": { "formatter": { "quoteStyle": "double" } }
    },
    {
      "includes": ["server/test/**"],
      // Tests read untyped JSON response bodies; the assertions are the check.
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    }
  ]
}
